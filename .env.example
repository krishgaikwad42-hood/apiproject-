# ─────────────────────────────────────────────────────────
# Smart Healthcare Diagnosis API — Environment Configuration
# Copy this file to `.env` and adjust values as needed.
# ─────────────────────────────────────────────────────────

# Server host (0.0.0.0 for Docker/production, 127.0.0.1 for local-only)
HOST=0.0.0.0

# Server port
PORT=8000

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
